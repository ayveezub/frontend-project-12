{
  "name": "@hexlet/code",
  "private": true,
  "version": "0.0.0",
  "description": "Slack-like chat (a very simplified version)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "start-server -s ./dist",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "lint": "oxlint .",
    "lint:fix": "oxfmt . && oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@hexlet/chat-server": "^3.0.0",
    "@mantine/core": "^9.8.1",
    "@mantine/form": "^9.8.1",
    "@mantine/hooks": "^9.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "fsevents": false,
    "@swc/core": false
  }
}
